# Loaded by `vite build --mode anna` (the Anna app). No secrets here: the Supabase URL and anon key come from
# .env.local or the CI variables, as for the website.
VITE_PYODIDE_BUNDLED=true
# The Anna app's sign-in popup returns to this page on the website (anna-callback.html).
VITE_ANNA_CALLBACK_URL=https://carthavate.github.io/ai-engineering-arena/anna-callback.html
